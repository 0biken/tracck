# Copy to .env.local (frontend) and set the same values in each service's
# environment. Names only: never commit real values.

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the API service, for example http://localhost:4000
NEXT_PUBLIC_API_URL=

# ─── API service (services/api) ──────────────────────────────────────────────
PORT=4000
# PostgreSQL connection string for the Supabase database (server only)
DATABASE_URL=
# The single Redis endpoint used for the job queue
REDIS_URL=
# Same value as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Only for Supabase projects on the legacy shared JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Origin of the frontend, for example http://localhost:3000
APP_ORIGIN=
# Enables POST /v1/diagnostic-jobs. Keep false in production.
ENABLE_DIAGNOSTIC_JOBS=false

# ─── Worker service (services/worker) ────────────────────────────────────────
# Also needs DATABASE_URL and REDIS_URL from above.
WORKER_CONCURRENCY=4
RECONCILE_INTERVAL_SECONDS=30
