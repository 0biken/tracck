# Copy to .env and fill in. Names only: never commit real values.
# Every variable below is read by src/config/env.ts.

# ─── Required ────────────────────────────────────────────────────────────────

PORT=4000
# PostgreSQL connection string for the Supabase database (server only).
# Use the transaction pooler (port 6543). `pnpm db:migrate` applies backend/drizzle to it.
DATABASE_URL=
# Redis for the job queue.
REDIS_URL=
# Same value as NEXT_PUBLIC_SUPABASE_URL in the frontend.
SUPABASE_URL=
# Only for projects still on the legacy shared JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Origin of the frontend, for example http://localhost:3000.
APP_ORIGIN=
# Enables POST /v1/diagnostic-jobs. Keep false in production.
ENABLE_DIAGNOSTIC_JOBS=false
# Background jobs run inside this process. Set false for an API-only instance.
RUN_JOB_WORKER=true
WORKER_CONCURRENCY=4
RECONCILE_INTERVAL_SECONDS=30

# ─── Storage and secrets ─────────────────────────────────────────────────────

# Public address of this API, used in links that other services call back (GitHub, Paystack).
API_PUBLIC_URL=
# Supabase service role key. Storage for CV uploads and exports needs it. Server only.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=tracck-private
# 32 random bytes, base64. Encrypts provider tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Local testing only: true skips plan limits (sources, resumes, Word export). Keep false in production.
DISABLE_PAYMENT_RESTRICTIONS=false

# ─── Integrations (optional: a feature without its settings answers 503) ─────

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PAYSTACK_SECRET_KEY=
# Paystack plan code (PLN_...) for the Pro price.
PAYSTACK_PRO_PLAN_CODE=
RESEND_API_KEY=
# For example: Tracck <hello@tracck.app>
EMAIL_FROM=

# ─── AI engine (optional: without GEMINI_API_KEY the placeholder engine runs) ─
# Gemini API key from Google AI Studio. The models each task uses are set in src/ai/ai.config.ts.

GEMINI_API_KEY=
