# Copy to .env and fill in. Names only: never commit real values.
PORT=4000
# PostgreSQL connection string for the Supabase database (server only).
# Use the transaction pooler (port 6543). `pnpm db:migrate` applies the migrations in backend/drizzle to it.
DATABASE_URL=
# The single Redis endpoint used for the job queue
REDIS_URL=
# Same value as NEXT_PUBLIC_SUPABASE_URL in the frontend
SUPABASE_URL=
# Only for Supabase projects on the legacy shared JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Origin of the frontend, for example http://localhost:3000
APP_ORIGIN=
# Enables POST /v1/diagnostic-jobs. Keep false in production.
ENABLE_DIAGNOSTIC_JOBS=false
# Background jobs run inside this same process.
# Set to false for an API-only instance that does not run jobs
RUN_JOB_WORKER=true
# How many run at once
WORKER_CONCURRENCY=4
# How often, in seconds, to recover jobs that lost their queue entry or went silent
RECONCILE_INTERVAL_SECONDS=30
