# Copy to .env and fill in. Names only: never commit real values.
PORT=4000
# PostgreSQL connection string for the Supabase database (server only)
DATABASE_URL=
# The single Redis endpoint used for the job queue (the workers use the same one)
REDIS_URL=
# Same value as NEXT_PUBLIC_SUPABASE_URL in the frontend
SUPABASE_URL=
# Only for Supabase projects on the legacy shared JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Origin of the frontend, for example http://localhost:3000
APP_ORIGIN=
# Enables POST /v1/diagnostic-jobs. Keep false in production.
ENABLE_DIAGNOSTIC_JOBS=false
