{
  "name": "@tracck/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "ai:seed": "tsx --env-file-if-exists=.env src/ai/seed-examples.ts",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@tracck/shared": "file:../shared",
    "bullmq": "^6.3.12",
    "csv-parse": "^7.0.3",
    "docx": "^9.13.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6",
    "@types/node": "^22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
