# Copy to .env.local. Names only: never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the backend API, for example http://localhost:4000
NEXT_PUBLIC_API_URL=
# Address server components use to reach the API (can be a private address).
# Optional: defaults to NEXT_PUBLIC_API_URL.
API_URL=
